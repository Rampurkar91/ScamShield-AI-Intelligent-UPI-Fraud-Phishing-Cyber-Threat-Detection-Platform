# Required. Use a PostgreSQL URL in production.
DATABASE_URL=sqlite:///./scamshield.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
# Set to production on Render. Never use the example secret in production.
ENVIRONMENT=development

# Optional. When configured, users may explicitly opt in to URL lookups.
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
